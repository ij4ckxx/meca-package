{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://meca-engine/schemas/config-schema/article-xml.schema.json",
  "title": "ArticleXmlConfig",
  "description": "Validates config/article-xml.yaml — Business Rule Book BR-051-075.",
  "type": "object",
  "required": [
    "doctype_public_id",
    "doctype_system_id",
    "dtd_version",
    "encoding",
    "pretty_indent_spaces"
  ],
  "additionalProperties": false,
  "properties": {
    "doctype_public_id": { "type": "string", "minLength": 1 },
    "doctype_system_id": { "type": "string", "minLength": 1 },
    "dtd_version": { "type": "string", "minLength": 1 },
    "encoding": { "type": "string", "minLength": 1 },
    "pretty_indent_spaces": { "type": "integer", "minimum": 0 }
  }
}
