{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://meca-engine/schemas/config-schema/raw-xml.schema.json",
  "title": "RawXmlConfig",
  "description": "Validates config/raw-xml.yaml — Business Rule Book BR-036–050.",
  "type": "object",
  "required": [
    "doctype_public_id",
    "doctype_system_id",
    "article_type",
    "dtd_version",
    "default_xml_lang",
    "encoding",
    "namespace_prefixes",
    "pretty_indent_spaces"
  ],
  "additionalProperties": false,
  "properties": {
    "doctype_public_id": { "type": "string", "minLength": 1 },
    "doctype_system_id": { "type": "string", "minLength": 1 },
    "article_type": { "type": "string", "minLength": 1 },
    "dtd_version": { "type": "string", "minLength": 1 },
    "default_xml_lang": { "type": "string", "minLength": 1 },
    "encoding": { "type": "string", "minLength": 1 },
    "namespace_prefixes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "pretty_indent_spaces": { "type": "integer", "minimum": 0 }
  }
}
