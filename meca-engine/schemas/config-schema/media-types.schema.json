{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://meca-engine/schemas/config-schema/media-types.schema.json",
  "title": "MediaTypeConfig",
  "description": "Validates config/media-types.yaml — 12_LLD_03_CONFIG_LOGGING_EXCEPTIONS.md §5.6 / ADR-008 / ADR-009.",
  "type": "object",
  "required": ["mappings", "unmapped_extension_policy", "unmapped_extension_default"],
  "additionalProperties": false,
  "properties": {
    "mappings": {
      "type": "object",
      "description": "Extension (with leading dot, lower-case) to MIME type.",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "unmapped_extension_policy": { "type": "string", "enum": ["warn_and_default", "fail"] },
    "unmapped_extension_default": { "type": "string", "minLength": 1 }
  }
}
