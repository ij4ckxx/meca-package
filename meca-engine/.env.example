# Environment-variable-sourced settings — 12_LLD_03 §5, 14_LLD_05 §12.3.
# Real secrets (AWS credentials, DB connection strings) come from a secrets manager
# in every deployed environment; this file documents the *names* the engine reads
# and provides safe, non-secret defaults for local development only.
#
# Copy to .env for local development: cp .env.example .env

# Which environment this process considers itself to be running in.
# One of: dev | staging | production
MECA_ENGINE_ENVIRONMENT=dev

# Root directory containing the config/ YAML tree (12_LLD_03 §5.1).
MECA_ENGINE_CONFIG_DIR=./config

# Enables the debug logging category (12_LLD_03 §6.3). Never true in production.
MECA_ENGINE_DEBUG_LOGGING=false

# --- Secrets placeholders (never set real values here; local dev only) ---
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# MECA_ENGINE_DB_DSN=
