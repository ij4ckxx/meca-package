# Environment-variable-sourced settings — 12_LLD_03 §5, 14_LLD_05 §12.3.
# Real secrets (AWS credentials, DB connection strings) come from a secrets manager
# in every deployed environment; this file documents the *names* the engine reads
# and provides safe, non-secret defaults for local development only.
#
# Copy to .env for local development: cp .env.example .env

# --- Core Engine Settings ---
MECA_ENGINE_ENVIRONMENT=dev
MECA_ENGINE_CONFIG_DIR=./config
MECA_ENGINE_DEBUG_LOGGING=false

# --- AWS S3 Configuration (Input Source) ---
# Note: AWS credentials (Access Key/Secret) are NOT required when using
# IAM Roles / AWS SSO / AWS CLI profiles (AWS Default Credential Provider Chain).
AWS_REGION=us-east-1
S3_BUCKET_NAME=your_s3_bucket
S3_INPUT_PREFIX=ppl/

# Optional: static AWS keys (leave commented out if using IAM Role / SSO)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- SFTP Configuration (Output Destination) ---
SFTP_HOST=poe.kriyadocs.com
SFTP_PORT=22
SFTP_USER=your_username
SFTP_PASSWORD=your_password
SFTP_REMOTE_DIR=/sftp/meca
# SFTP_KEY_PATH=
# SFTP_DELETE_LOCAL_AFTER_UPLOAD=false

# --- Database placeholder (optional, future phase) ---
# MECA_ENGINE_DB_DSN=

